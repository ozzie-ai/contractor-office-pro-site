{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take photos of the job so the AI can see it. Photos stay private on your iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toma fotos del trabajo para que la IA lo vea. Las fotos se quedan privadas en tu iPhone."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets you describe the job by voice. Audio stays on your iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te permite describir el trabajo con tu voz. El audio se queda en tu iPhone."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turns what you say into job notes, on your iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Convierte lo que dices en notas del trabajo, en tu iPhone."
          }
        }
      }
    }
  }
}
