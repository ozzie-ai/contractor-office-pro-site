    "session.offline.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first launch needs internet once to set up your account. After that, the app works offline."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La primera vez necesitas internet para configurar tu cuenta. Después, la app funciona sin conexión."
          }
        }
      }
    },
