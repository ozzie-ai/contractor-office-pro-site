    "auth.error.invalid_code": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That code didn't work. Check it or request a new one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese código no funcionó. Revísalo o pide uno nuevo."
