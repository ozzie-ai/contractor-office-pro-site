    "sync.pending": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$(count)lld change waiting to upload"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$(count)lld changes waiting to upload"
                }
              }
            }
          }
        },
