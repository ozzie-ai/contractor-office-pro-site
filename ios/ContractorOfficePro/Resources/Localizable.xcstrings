    "auth.error.invalid_email": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a valid email address."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe un correo electrónico válido."
          }
        }
      }
