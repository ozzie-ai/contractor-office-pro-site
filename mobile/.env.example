# Optional Derek AI service for the existing Expo pilot
# Copy this to mobile/.env and fill the PUBLIC values from your test accounts.
# These values can appear in the app bundle. Never put OpenAI secrets,
# Supabase service-role keys, bank details or private access tokens here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_COP_BACKEND_URL=
